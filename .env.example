# Copy to .env for local use. .env is gitignored and excluded from the Docker image.
# On Render, enter these in the dashboard instead (Environment tab); never commit real values.
ANTHROPIC_API_KEY=
ACCESS_CODE=

# Optional
LEDGER_CAP_USD=4.00      # the server refuses new live runs once recorded spend would pass this
BUDGET_STAGE3=0.35       # per-run cost caps in USD
BUDGET_STAGE4=0.25
